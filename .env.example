# Copy to .env and fill in. Never commit .env.

# Ports published on the host.
WEB_PORT=3100
API_PORT=8000

DB_PORT=5433

# Postgres for votes and rate-limit counters. This is the local Docker database
# (`docker compose up -d db`); in public it is the Neon connection string.
DATABASE_URL=postgres://arena:arena-local@localhost:5433/arena

# Keys the hash of a voter's address. Leave empty locally; set a long random
# value on the public deployment.
ARENA_IP_HASH_KEY=

# Claude subscription login, used only to record runs. Create it on the host with
# `claude setup-token`. Local use only. Do NOT set ANTHROPIC_API_KEY: the runner
# refuses to start a Claude run if any API key is present.
CLAUDE_CODE_OAUTH_TOKEN=

# Leave unset. The runner refuses models that are not marked free; setting this
# to 1 allows paid models and can cost money.
# ARENA_ALLOW_PAID_MODELS=
