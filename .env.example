# Copy to .env and fill in. Never commit .env.

# Ports published on the host.
WEB_PORT=3100
API_PORT=8000

# Model provider keys, read by LiteLLM from Phase 2 onward. Set the ones you have.
# They are only needed for live runs and recording; replay mode makes no model calls.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin token for live mode and config management (used from Phase 4 onward).
ARENA_ADMIN_TOKEN=
