# Copy to .env and fill in. Never commit .env.

# Ports published on the host.
WEB_PORT=3100
API_PORT=8000

# Free-tier model keys, read by LiteLLM. Only needed for live runs and recording;
# the public replay site makes no model calls.
# GEMINI_API_KEY: create it in a Google Cloud project WITHOUT billing enabled,
# otherwise the same models are billed.
GEMINI_API_KEY=
# GROQ_API_KEY: keep the Groq account on the free plan.
GROQ_API_KEY=

# Claude subscription login, for the Claude configs only. Create it on the host with
# `claude setup-token`. Local use only. Do NOT set ANTHROPIC_API_KEY: the runner
# refuses to start a Claude run if any API key is present.
CLAUDE_CODE_OAUTH_TOKEN=

# Leave unset. The runner refuses models that are not marked free; setting this
# to 1 allows paid models and can cost money.
# ARENA_ALLOW_PAID_MODELS=
